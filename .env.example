# Copy to .env for local health/auth checks. Collection stays disabled.
PORT=3000
ENVIRONMENT=development
CRAWLER_ROOT_URL=https://mrtdown-data-crawler.fly.dev
CRAWLER_ENABLED=false
COLLECTION_ENABLED=false
GTFS_PUBLICATION_ENABLED=false
GTFS_NOTIFICATION_ENABLED=false
QSTASH_CURRENT_SIGNING_KEY=synthetic-local-current-key
QSTASH_NEXT_SIGNING_KEY=synthetic-local-next-key

# Required before enabling real acquisition; use separate test buckets locally.
TWITTER_BEARER_TOKEN=
GITHUB_ACCESS_TOKEN=
LTA_DATAMALL_ACCOUNT_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRIVATE_BUCKET=
R2_PUBLIC_BUCKET=
SENTRY_DSN=

# Only used by schedule provisioning, never by the service.
QSTASH_URL=
QSTASH_TOKEN=
