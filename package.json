{
  "name": "mrtdown-data-crawler",
  "version": "1.0.0",
  "main": "dist/index.mjs",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "node dist/index.mjs",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node24 --packages=external --format=esm --outfile=dist/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check src scripts package.json tsconfig.json",
    "check": "npm run typecheck && npm run lint && npm test",
    "qstash:schedules:sync": "tsx scripts/qstash-schedules.ts"
  },
  "author": "",
  "license": "MIT",
  "description": "",
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/luxon": "^3.7.2",
    "@types/node": "26.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@hono/node-server": "^2.1.3",
    "@mrtdown/ingest-contracts": "^2.0.0-alpha.27",
    "@sentry/node": "^11.4.0",
    "@upstash/qstash": "^2.12.0",
    "hast-util-from-html": "^2.0.3",
    "hono": "^4.13.13",
    "luxon": "^3.7.2",
    "rss-parser": "^3.13.0"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  }
}
