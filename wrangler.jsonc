{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mrtdown-data-crawler",
  "compatibility_date": "2025-04-05",
  "main": "src/index.ts",
  "observability": {
    "logs": {
      "enabled": true
    }
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "ENVIRONMENT": "development",
    "COLLECTION_ENABLED": "false",
    "SCHEDULE_CRON": "0 20 * * *",
    "REALTIME_CRON": "*/2 * * * *",
    "GTFS_PUBLICATION_ENABLED": "false",
    "GTFS_NOTIFICATION_ENABLED": "false"
  },
  "env": {
    "production": {
      "name": "mrtdown-data-crawler",
      "vars": {
        "ENVIRONMENT": "production",
        "COLLECTION_ENABLED": "true",
        "SCHEDULE_CRON": "0 20 * * *",
        "REALTIME_CRON": "*/2 * * * *",
        "GTFS_PUBLICATION_ENABLED": "true",
        "GTFS_NOTIFICATION_ENABLED": "false"
      },
      "r2_buckets": [
        {
          "binding": "SNAPSHOTS",
          "bucket_name": "mrtdown-datamall-snapshots"
        },
        {
          "binding": "GTFS_PUBLIC",
          "bucket_name": "mrtdown-public-snapshots"
        }
      ],
      "triggers": {
        "crons": ["* * * * *"]
      },
      "version_metadata": {
        "binding": "CF_VERSION_METADATA"
      }
    }
  },
  "r2_buckets": [
    {
      "binding": "SNAPSHOTS",
      "bucket_name": "mrtdown-datamall-snapshots"
    },
    {
      "binding": "GTFS_PUBLIC",
      "bucket_name": "mrtdown-public-snapshots"
    }
  ]
}
